      "checkConstraints": {
        "order_edition": {
          "name": "order_edition",
          "value": "\"orders\".\"edition\" IN ('paperback','hardcover')"
        },
        "order_quantity": {
          "name": "order_quantity",
          "value": "\"orders\".\"quantity\" BETWEEN 1 AND 10"
        },
        "order_payment": {
          "name": "order_payment",
          "value": "\"orders\".\"payment_status\" IN ('pending','paid','failed','refunded','partially_refunded')"
        },
        "order_fulfillment": {
          "name": "order_fulfillment",
          "value": "\"orders\".\"fulfillment_status\" IN ('pending','shipped')"
        },
        "order_total": {
          "name": "order_total",
          "value": "\"orders\".\"total\" = \"orders\".\"subtotal\" + \"orders\".\"shipping\" AND \"orders\".\"shipping\" >= 0 AND \"orders\".\"subtotal\" >= 0"
        }
